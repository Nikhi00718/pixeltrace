  "reference": "class Solution {\npublic:\n    void rotate(vector<vector<int>>& matrix) {\n        int n = matrix.size();\n        for (int i = 0; i < n; i++)\n            for (int j = i + 1; j < n; j++) swap(matrix[i][j], matrix[j][i]);\n        for (int i = 0; i < n; i++) reverse(matrix[i].begin(), matrix[i].end());\n    }\n};",
