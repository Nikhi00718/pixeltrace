  "reference": "class Solution {\npublic:\n    vector<int> findSmallestSetOfVertices(int n, vector<vector<int>>& edges) {\n        vector<int> indeg(n, 0);\n        for (auto& e : edges) indeg[e[1]]++;\n        vector<int> res;\n        for (int v = 0; v < n; v++) {\n            if (indeg[v] == 0) res.push_back(v);\n        }\n        return res;\n    }\n};",
