  "reference": "class Solution {\npublic:\n    vector<vector<int>> flipAndInvertImage(vector<vector<int>>& image) {\n        for (int r = 0; r < (int)image.size(); r++) {\n            int l = 0, rr = image[r].size() - 1;\n            while (l <= rr) {\n                int a = image[r][l] ^ 1, b = image[r][rr] ^ 1;\n                image[r][l] = b;\n                image[r][rr] = a;\n                l++;\n                rr--;\n            }\n        }\n        return image;\n    }\n};",
