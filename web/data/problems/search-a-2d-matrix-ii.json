  "reference": "class Solution {\npublic:\n    bool searchMatrix(vector<vector<int>>& matrix, int target) {\n        int r = 0, c = matrix[0].size() - 1;\n        while (r < (int)matrix.size() && c >= 0) {\n            if (matrix[r][c] == target) return true;\n            if (matrix[r][c] > target) c--;\n            else r++;\n        }\n        return false;\n    }\n};",
