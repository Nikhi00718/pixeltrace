  "reference": "class Solution {\npublic:\n    void setZeroes(vector<vector<int>>& matrix) {\n        int m = matrix.size(), n = matrix[0].size();\n        vector<bool> row(m, false), col(n, false);\n        for (int i = 0; i < m; i++)\n            for (int j = 0; j < n; j++)\n                if (matrix[i][j] == 0) {\n                    row[i] = true;\n                    col[j] = true;\n                }\n        for (int i = 0; i < m; i++)\n            for (int j = 0; j < n; j++)\n                if (row[i] || col[j]) matrix[i][j] = 0;\n    }\n};",
