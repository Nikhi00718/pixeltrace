  "reference": "class Solution {\npublic:\n    void leaves(TreeNode* node, vector<int>& out) {\n        if (!node) return;\n        if (!node->left && !node->right) out.push_back(node->val);\n        leaves(node->left, out);\n        leaves(node->right, out);\n    }\n    bool leafSimilar(TreeNode* root1, TreeNode* root2) {\n        vector<int> a, b;\n        leaves(root1, a);\n        leaves(root2, b);\n        return a == b;\n    }\n};",
