  "reference": "class Solution {\npublic:\n    int heightChecker(vector<int>& heights) {\n        vector<int> sorted = heights;\n        sort(sorted.begin(), sorted.end());\n        int wrong = 0;\n        for (int i = 0; i < (int)heights.size(); i++) wrong += heights[i] != sorted[i];\n        return wrong;\n    }\n};",
