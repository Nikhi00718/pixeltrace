  "reference": "class Solution {\npublic:\n    int findCenter(vector<vector<int>>& edges) {\n        int a = edges[0][0], b = edges[0][1];\n        return (a == edges[1][0] || a == edges[1][1]) ? a : b;\n    }\n};",
