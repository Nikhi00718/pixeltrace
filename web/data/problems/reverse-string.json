  "reference": "class Solution {\npublic:\n    void reverseString(vector<char>& s) {\n        int l = 0, r = s.size() - 1;\n        while (l < r) {\n            swap(s[l], s[r]);\n            l++;\n            r--;\n        }\n    }\n};",
