  "reference": "class Solution {\npublic:\n    vector<vector<int>> transpose(vector<vector<int>>& matrix) {\n        int m = matrix.size(), n = matrix[0].size();\n        vector<vector<int>> res(n, vector<int>(m));\n        for (int r = 0; r < m; r++)\n            for (int c = 0; c < n; c++) res[c][r] = matrix[r][c];\n        return res;\n    }\n};",
