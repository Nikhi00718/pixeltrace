  "reference": "class Solution {\npublic:\n    int total = 0;\n    void walk(TreeNode* node) {\n        if (!node) return;\n        walk(node->right);\n        total += node->val;\n        node->val = total;\n        walk(node->left);\n    }\n    TreeNode* convertBST(TreeNode* root) {\n        walk(root);\n        return root;\n    }\n};",
