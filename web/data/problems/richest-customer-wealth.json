  "reference": "class Solution {\npublic:\n    int maximumWealth(vector<vector<int>>& accounts) {\n        int best = 0;\n        for (int i = 0; i < (int)accounts.size(); i++) {\n            int sum = 0;\n            for (int j = 0; j < (int)accounts[i].size(); j++) sum += accounts[i][j];\n            best = max(best, sum);\n        }\n        return best;\n    }\n};",
