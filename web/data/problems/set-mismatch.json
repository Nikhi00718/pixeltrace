  "story": {
    "title": "One Badge Copied, One Lost",
    "text": "Badges 1..n should each appear once. Tally them; the badge counted twice is the duplicate and the badge counted zero times is the missing one.",
    "goal": "Return [duplicate, missing]."
  },
  "spec": {
    "method": "findErrorNums",
    "ret": "vector<int>",
    "params": [
      [
        "vector<int>&",
        "nums"
      ]
    ]
  },
  "tests": [
    {
      "args": [
        [
          1,
          2,
          2,
          4
        ]
      ],
      "expected": [
        2,
        3
      ]
    },
    {
      "args": [
        [
          1,
          1
        ]
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "args": [
        [
          3,
          2,
          3,
          4,
          6,
          5
        ]
      ],
      "expected": [
        3,
        1
      ]
    }
  ],
  "visualTest": 2,
  "scene": {
    "theme": "castle",
    "layers": [
      {
        "kind": "array",
        "var": "nums",
