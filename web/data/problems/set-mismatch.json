  },
  "reference": "class Solution {\npublic:\n    vector<int> findErrorNums(vector<int>& nums) {\n        int n = nums.size(), dup = 0, miss = 0;\n        vector<int> cnt(n + 1, 0);\n        for (int x : nums) cnt[x]++;\n        for (int v = 1; v <= n; v++) {\n            if (cnt[v] == 2) dup = v;\n            if (cnt[v] == 0) miss = v;\n        }\n        return {dup, miss};\n    }\n};",
  "tier": "crafted"
